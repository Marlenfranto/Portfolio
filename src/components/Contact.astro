---
import { siteConfig } from '../data/site';

const mailto = `mailto:${siteConfig.email}?subject=Portfolio enquiry`;
---

<form class="contact-form" action={mailto} method="post" enctype="text/plain">
  <div class="field">
    <label for="contact-name">Name</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Your name…" required />
  </div>
  <div class="field">
    <label for="contact-email">Email</label>
    <input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" placeholder="you@example.com…" required />
  </div>
  <div class="field">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" autocomplete="off" placeholder="Share the role, project, timeline, or collaboration context…" required></textarea>
  </div>
  <button class="button primary" type="submit">Send Message</button>
  <p class="status-message" role="status" aria-live="polite">
    This opens your email app so you can send the message directly to Marlen.
  </p>
</form>
