---
import '../styles/global.css';
import '../styles/cosmic-experience.css';
import { siteConfig } from '../data/site';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CosmicInterface from './CosmicInterface.astro';

type Breadcrumb = { name: string; url: string };

const {
  title = 'Marlen Franto | Senior Flutter & Full-Stack Mobile Engineer',
  description = 'Senior Flutter and full-stack mobile engineer with 7+ years across Android, iOS, Web, desktop, Serverpod APIs, analytics, offline-first, GIS, BLE, and cloud.',
  path = Astro.url.pathname,
  image = siteConfig.defaultSocialImage,
  imageAlt = 'Marlen Franto portfolio social preview',
  type = 'website',
  publishedDate,
  updatedDate,
  noindex = false,
  breadcrumbs = [],
  structuredData = [],
  bodyClass = '',
} = Astro.props as {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedDate?: string;
  updatedDate?: string;
  noindex?: boolean;
  breadcrumbs?: Breadcrumb[];
  structuredData?: Record<string, unknown>[];
  bodyClass?: string;
};

const canonicalPath = path.endsWith('/') ? path : `${path}/`;
const canonicalUrl = new URL(canonicalPath, siteConfig.url).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, siteConfig.url).toString();
const isPreviewDeployment = import.meta.env.VERCEL_ENV === 'preview';
const shouldLoadVercelInsights = import.meta.env.PUBLIC_ENABLE_VERCEL_ANALYTICS === 'true' && import.meta.env.VERCEL === '1' && !isPreviewDeployment;
const robots = noindex || isPreviewDeployment ? 'noindex,nofollow' : 'index,follow';
const allStructuredData = [
  ...structuredData,
  ...(breadcrumbs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: breadcrumbs.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: item.name,
            item: new URL(item.url, siteConfig.url).toString(),
          })),
        },
      ]
    : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#050816" />
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate} />}
    <link rel="icon" type="image/svg+xml" href="/m-logo.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {shouldLoadVercelInsights && <script is:inline defer src="/_vercel/insights/script.js"></script>}
    {shouldLoadVercelInsights && <script is:inline defer src="/_vercel/speed-insights/script.js"></script>}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {allStructuredData.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class={bodyClass}>
    <div class="galaxy-backdrop" aria-hidden="true">
      <span class="star-layer star-layer-near"></span>
      <span class="star-layer star-layer-far"></span>
      <span class="nebula-layer nebula-layer-one"></span>
      <span class="nebula-layer nebula-layer-two"></span>
      <span class="galaxy-orbit orbit-one"></span>
      <span class="galaxy-orbit orbit-two"></span>
      <span class="galaxy-comet"></span>
    </div>
    <CosmicInterface />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      (() => {
        const root = document.documentElement;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const palette = ['#58d6ff', '#a78bfa', '#ff7ab6', '#67e8f9', '#facc15', '#5eead4'];
        const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');
        const immersiveSections = document.querySelectorAll<HTMLElement>('[data-immersive-section]');
        const header = document.querySelector<HTMLElement>('[data-site-header]');
        const percent = document.querySelector<HTMLElement>('[data-scroll-percent]');
        const navTargets = document.querySelectorAll<HTMLElement>('[data-nav-target], [data-journey-link]');

        document
          .querySelectorAll<HTMLElement>('main > .section:not([data-immersive-section]), main > article.section:not([data-immersive-section])')
          .forEach((section, index) => {
            section.setAttribute('data-immersive-section', '');
            section.classList.add('immersive-section', 'immersive-page-section');
            section.style.setProperty('--planet-color', palette[index % palette.length]);
            section.style.setProperty('--planet-index', String(index + 1));
          });

        const setCurrentNavigation = (activeId: string) => {
          navTargets.forEach((target) => {
            const targetId = target.dataset.navTarget || target.dataset.journeyLink;
            const isCurrent = targetId === activeId;
            target.classList.toggle('is-current', isCurrent);
            if (isCurrent) target.setAttribute('aria-current', target.hasAttribute('data-journey-link') ? 'step' : 'location');
            else target.removeAttribute('aria-current');
          });
        };

        document.body.classList.add('is-ready');
        setCurrentNavigation('home');

        if (reduced || !('IntersectionObserver' in window)) {
          revealTargets.forEach((target) => target.classList.add('is-visible'));
          immersiveSections.forEach((section) => section.classList.add('is-active'));
        } else {
          const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            });
          }, { rootMargin: '0px 0px -8%', threshold: 0.08 });
          revealTargets.forEach((target) => revealObserver.observe(target));

          const sectionObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => entry.target.classList.toggle('is-active', entry.isIntersecting));
          }, { rootMargin: '-18% 0px -18%', threshold: 0.01 });
          immersiveSections.forEach((section) => sectionObserver.observe(section));
        }

        let scrollFrame = 0;
        const updateScrollInterface = () => {
          const range = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
          const progress = Math.min(1, Math.max(0, window.scrollY / range));
          root.style.setProperty('--page-progress', progress.toFixed(4));
          if (percent) percent.textContent = `${String(Math.round(progress * 100)).padStart(2, '0')}%`;
          header?.classList.toggle('is-compact', window.scrollY > 28);
          scrollFrame = 0;
        };

        const requestScrollUpdate = () => {
          if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateScrollInterface);
        };

        window.addEventListener('portfolio-orbit-change', (event) => {
          const detail = (event as CustomEvent<{ id?: string }>).detail;
          if (detail?.id) setCurrentNavigation(detail.id);
        });
        window.addEventListener('scroll', requestScrollUpdate, { passive: true });
        window.addEventListener('resize', requestScrollUpdate, { passive: true });
        updateScrollInterface();
      })();
    </script>
  </body>
</html>
