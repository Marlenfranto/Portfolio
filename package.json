{
  "name": "marlen-franto-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run resume:pdf",
    "build": "astro check && astro build && node scripts/validate-site.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "preview": "astro preview",
    "resume:pdf": "node scripts/generate-resume-pdf.mjs",
    "test": "npm run build && npm run test:e2e",
    "test:lighthouse": "npx @lhci/cli@0.15.x autorun",
    "test:e2e": "playwright test",
    "test:site": "node scripts/validate-site.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.5.1",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2"
  }
}
